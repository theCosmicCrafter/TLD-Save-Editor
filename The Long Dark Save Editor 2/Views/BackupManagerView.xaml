<UserControl x:Class="The_Long_Dark_Save_Editor_2.Views.BackupManagerView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
             Width="500" Height="400">
    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>
        <TextBlock Grid.Row="0" FontSize="18" FontWeight="Bold" Margin="0 0 0 10">Backup Manager</TextBlock>
        <ListBox Grid.Row="1" Name="BackupList" SelectionMode="Single">
            <ListBox.ItemTemplate>
                <DataTemplate>
                    <StackPanel Orientation="Horizontal" Margin="0 2">
                        <materialDesign:PackIcon Kind="FileRestore" Width="20" Height="20" VerticalAlignment="Center" Margin="0 0 8 0"/>
                        <TextBlock Text="{Binding DisplayName}" VerticalAlignment="Center" FontSize="14"/>
                    </StackPanel>
                </DataTemplate>
            </ListBox.ItemTemplate>
        </ListBox>
        <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0 10 0 0">
            <Button Style="{StaticResource MaterialDesignFlatButtonNoRounding}" Click="RestoreClicked" Content="Restore" Margin="0 0 10 0"/>
            <Button Style="{StaticResource MaterialDesignFlatButtonNoRounding}" Click="DeleteClicked" Content="Delete" Margin="0 0 10 0"/>
            <Button Style="{StaticResource MaterialDesignFlatButtonNoRounding}" Click="OpenFolderClicked" Content="Open Folder" Margin="0 0 10 0"/>
            <Button Style="{StaticResource MaterialDesignFlatButtonNoRounding}" Click="CloseClicked" Content="Close"/>
        </StackPanel>
    </Grid>
</UserControl>
